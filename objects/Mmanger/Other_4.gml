// Main Menu
if (room == rm_main_menu)
{
    set_song_ingame(Start, 60, 0); // Play 'Start' track for main menu
}

// The Beach
if (room == The_Beach)
{
    set_song_ingame(Beach_Track, 60, 0); // Replace 'Beach_Track' with your actual beach music asset
}

// Deserted Snows
if (room == Deserted_snows)
{
    set_song_ingame(Deserted_snow_track, 60, 0);
}

// Murad Cave
if (room == Murad_Cave)
{
    set_song_ingame(Cavem, 60, 0);
}
if (room == Chi_cafe)
{
	set_song_ingame(Cafe, 60, 0);
}